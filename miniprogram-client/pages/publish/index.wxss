.tabs {
  display: flex;
  border: 1px solid #dbe4f0;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #f8fbff;
}

.active {
  background: #ffffff;
  color: #1677ff;
  font-weight: 700;
}

.ipt,
.txt {
  border: 1px solid #dbe4f0;
  border-radius: 14rpx;
  background: #fff;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
}

.ipt {
  height: 76rpx;
}

.txt {
  min-height: 150rpx;
}

.picker {
  border: 1px solid #dbe4f0;
  border-radius: 14rpx;
  background: #fff;
  padding: 16rpx;
  margin-bottom: 12rpx;
  color: #334155;
}

.img-tools {
  margin-bottom: 12rpx;
}

.img-row {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}
